<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.jnu.zhangcs.jsqlint.server.mapper.SqlChangeLogMapper">

    <resultMap id="BaseResultMap" type="cn.jnu.zhangcs.jsqlint.server.entity.SqlChangeLog">
        <id column="id" property="id"/>
        <result column="project_id" property="projectId"/>
        <result column="from_version_id" property="fromVersionId"/>
        <result column="to_version_id" property="toVersionId"/>
        <result column="statement_id" property="statementId"/>
        <result column="change_type" property="changeType"/>
        <result column="from_sql_hash" property="fromSqlHash"/>
        <result column="to_sql_hash" property="toSqlHash"/>
        <result column="diff_summary" property="diffSummary" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 批量插入 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO jsl_sql_change_log (
            project_id, from_version_id, to_version_id, statement_id, change_type,
            from_sql_hash, to_sql_hash, diff_summary
        ) VALUES
        <foreach collection="logs" item="item" separator=",">
            (
                #{item.projectId}, #{item.fromVersionId}, #{item.toVersionId},
                #{item.statementId}, #{item.changeType}, #{item.fromSqlHash},
                #{item.toSqlHash},
                #{item.diffSummary, typeHandler=com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler}
            )
        </foreach>
    </insert>

</mapper>
