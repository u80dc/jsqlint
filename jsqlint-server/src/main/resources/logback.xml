<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="300 seconds" debug="false">
    <!-- 日志文件路径 -->
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
    <property name="FILE_NAME" value="${FILE_NAME:-server}"/>
    <property name="FILE_SUFFIX" value="${FILE_SUFFIX:-log}"/>
    <!-- 单文件最大大小 -->
    <property name="MAX_FILE_SIZE" value="200MB"/>
    <!-- 保留天数 -->
    <property name="MAX_HISTORY" value="15"/>
    <!-- 日志文件总大小 -->
    <property name="TOTAL_FILE_SIZE" value="10GB"/>
    <!-- 日志格式 -->
    <property name="PATTERN" value="[%d{yyyy-MM-dd HH:mm:ss.SSS}] [%-5level] [%t] %msg%n"/>
    <property name="LOG_CHARSET" value="UTF-8"/>

    <!-- 控制台打印输出 -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <!-- 格式化 -->
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 服务日志输出 -->
    <appender name="SERVER_INFO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${FILE_NAME}.${FILE_SUFFIX}</file>
        <!-- 滚动策略类 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${FILE_NAME}_%d{yyyy-MM-dd}.%i.${FILE_SUFFIX}.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_FILE_SIZE}</totalSizeCap>
        </rollingPolicy>
        <!-- 格式化 -->
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <!-- 服务异常日志输出 -->
    <appender name="SERVER_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${FILE_NAME}_error.${FILE_SUFFIX}</file>
        <!-- 滚动策略类 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${FILE_NAME}_error_%d{yyyy-MM-dd}.%i.${FILE_SUFFIX}.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_FILE_SIZE}</totalSizeCap>
        </rollingPolicy>
        <!-- 格式化 -->
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
        <!-- 日志级别过滤 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>

    <!-- 业务全局日志 -->
    <logger name="cn.jnu.zhangcs.jsqlint" level="info"/>

    <!-- 其余服务日志 -->
    <root level="info">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="SERVER_INFO"/>
        <appender-ref ref="SERVER_ERROR"/>
    </root>

</configuration>