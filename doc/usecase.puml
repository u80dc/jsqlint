@startuml
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
    BackgroundColor #FDF6E3
    BorderColor #2C3E50
    ArrowColor #34495E
}
title 图 x-x jsqlint 系统用例图

' ==================== 参与者 ====================
' 全局角色轴：系统管理员为独立平台角色，与项目角色无继承关系
' 项目角色轴：普通用户创建/加入项目后成为项目管理员（项目内角色）
actor "普通用户\n(项目成员)" as User
actor "项目管理员" as PAdmin
actor "系统管理员" as Admin

User <|-- PAdmin : 创建项目 / 被任命

' ==================== 用例 ====================
rectangle "jsqlint SQL 治理中心" {
    usecase "项目接入管理\n(Git 配置 / 凭证)" as UC01
    usecase "触发 SQL 分析\n与进度查看" as UC02
    usecase "查看 SQL 清单\n与构造详情" as UC03
    usecase "查看审核报告\n与质量概览" as UC04
    usecase "处理审核问题\n(确认 / 修复 / 豁免)" as UC05
    usecase "维护项目级\n审核规则" as UC06
    usecase "维护全局审核规则\n与白名单" as UC07
    usecase "用户与系统管理" as UC08
}

' ==================== 关系 ====================
User --> UC01
User --> UC02
User --> UC03
User --> UC04

PAdmin --> UC05
PAdmin --> UC06

Admin --> UC07
Admin --> UC08

' ==================== include / extend ====================
UC05 ..> UC07 : <<extend>> 豁免时入白名单
UC03 ..> UC02 : <<include>>

@enduml
