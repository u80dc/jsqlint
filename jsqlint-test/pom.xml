<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.u80dc.jsqlint</groupId>
        <artifactId>jsqlint</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jsqlint-test</artifactId>
    <packaging>jar</packaging>
    <description>统一测试模块，集中存放各模块的测试代码及测试资源</description>

    <dependencies>
        <dependency><groupId>org.u80dc.jsqlint</groupId><artifactId>jsqlint-mybatis-plus</artifactId><version>${revision}</version><scope>test</scope></dependency>
        <!-- 受控测试使用真实框架生成 BoundSql；分析器不加载目标实体。 -->
        <dependency><groupId>com.baomidou</groupId><artifactId>mybatis-plus-core</artifactId><version>3.5.16</version><scope>test</scope></dependency>
        <dependency><groupId>com.baomidou</groupId><artifactId>mybatis-plus-spring</artifactId><version>3.5.16</version><scope>test</scope></dependency>
        <!-- 实际 Service/Lambda 链 oracle 的可选 Spring SPI 运行依赖；不传入目标分析视图。 -->
        <dependency><groupId>org.springframework</groupId><artifactId>spring-context</artifactId><version>5.3.39</version><scope>test</scope></dependency>
        <dependency><groupId>org.springframework</groupId><artifactId>spring-jdbc</artifactId><version>5.3.39</version><scope>test</scope></dependency>
        <dependency><groupId>org.mybatis</groupId><artifactId>mybatis-spring</artifactId><version>2.1.2</version><scope>test</scope></dependency>
        <!-- 扩展样例独立运行的数据库 oracle；不传入 Analyzer 的项目分析输入。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.4.240</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.u80dc.jsqlint</groupId>
            <artifactId>jsqlint-jdbc</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.u80dc.jsqlint</groupId>
            <artifactId>jsqlint-mybatis</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.u80dc.jsqlint</groupId>
            <artifactId>jsqlint-commons</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.u80dc.jsqlint</groupId>
            <artifactId>jsqlint-core</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
