<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.u80dc.jsqlint.samples.mybatis.UserMapper">
    <sql id="username">username</sql>
    <select id="find" resultType="string">
        SELECT <include refid="username"/> FROM app_users WHERE id=#{id}
    </select>
    <update id="rename">
        UPDATE app_users <set>username=#{name},</set> WHERE id=#{id}
    </update>
    <select id="search" resultType="string">
        SELECT username FROM app_users WHERE ${column}=#{value}
    </select>
    <select id="optional" resultType="string">
        <bind name="pattern" value="'%' + name + '%'"/>
        SELECT username FROM app_users
        <where><if test="name != null and name != ''">AND username LIKE #{pattern}</if></where>
    </select>
</mapper>
